# /srv/confoinfo/.env 견본. 복사해서 채운다.
#
#   cp deploy/srv/env.template /srv/confoinfo/.env && chmod 660 /srv/confoinfo/.env

# 지금 도는 이미지 판. deploy.sh 가 이 줄만 제자리에서 고친다.
IMAGE_TAG=v0.1.0

# DB. 디렉토리째 마운트하는 그 안에 있다. 1단계에서는 학회 자료의 사본뿐이라
# 지워도 다음 기동에 다시 생긴다 — 2단계(동기화)부터는 사람의 자료가 들어간다.
CONFOINFO_DB=/srv/confoinfo/db/confoinfo.db

CONFOINFO_DEBUG=0
# 반드시 바꿀 것:  python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
CONFOINFO_SECRET_KEY=CHANGE-ME

# settings.py 의 ALLOWED_HOSTS 에 더해진다. 보통 비워 둔다.
CONFOINFO_HOSTS=

# 서브경로 배포. nginx 가 /confoinfo/ 를 떼고 넘기므로 Django 는 링크를 만들 때만
# 이 값을 앞에 붙인다 (deploy/nginx/confoinfo-subpath.conf).
CONFOINFO_SCRIPT_NAME=/confoinfo

GUNICORN_WORKERS=2
