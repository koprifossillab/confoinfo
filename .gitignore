__pycache__/
*.pyc
.venv/

# 장비마다 다른 값 (DB 위치, 비밀키). .env.template 이 견본이다
.env

# devdocs/guides 로 가는 심볼릭 링크 — devdocs 는 private 이다 (CLAUDE.md)
.guides

# DB 는 학회 자료(conferences/*.json)의 사본이다 — import_conference 로 언제든 다시 생긴다
confoinfo.db
confoinfo.db-wal
confoinfo.db-shm

# collectstatic 산출물 (이미지 빌드에서만 생긴다)
web/staticfiles/

# 학회 원본 PDF — 용량이 크고 배포처의 것이다. 파서의 산출물(output/)만 추적한다
sources/*/data/
sources/*/build/
