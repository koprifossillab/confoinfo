# 장비마다 다른 값. `.env` 로 복사해서 채운다 (`.env` 는 gitignore).
# settings.py 가 이 파일을 읽는다. 컨테이너는 compose 가 환경변수를 직접 준다.

# DB. 비우면 저장소 뿌리의 confoinfo.db. 학회 자료의 사본이라 지워도 된다:
#   python web/manage.py migrate && python web/manage.py import_conference --all
#CONFOINFO_DB=

# 학회 자료 위치. 비우면 저장소의 conferences/
#CONFOINFO_CONFERENCES_DIR=

# 운영으로 돌릴 때 반드시 채운다
#CONFOINFO_SECRET_KEY=
#CONFOINFO_DEBUG=0

# 서브경로 아래에서 시험할 때 (운영은 /confoinfo)
#CONFOINFO_SCRIPT_NAME=
